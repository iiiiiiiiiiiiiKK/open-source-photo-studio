# ---------- 服务端 ----------
# API 监听端口（前端 dev server 会代理到 http://127.0.0.1:8931）
PORT=8931
HOST=0.0.0.0

# ---------- GitHub ----------
# 可选。不填时使用匿名调用（每小时 60 次），建议配置以提高配额。
GITHUB_TOKEN=

# ---------- 截图（无头浏览器） ----------
# 可选。留空时自动探测本机 Chrome / Edge / Chromium 常见安装路径。
# 例：Windows  C:\Program Files\Google\Chrome\Application\chrome.exe
#     macOS    /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#     Linux    /usr/bin/chromium
CHROME_PATH=

# 单次导航超时（毫秒）
SHOT_TIMEOUT_MS=25000
# 整个截图任务的时间预算（毫秒）
SHOT_BUDGET_MS=45000
# 截图最大高度（px），用于长截图裁剪，防止内存爆炸
SHOT_MAX_HEIGHT=3200
# 同时进行的截图任务数
SHOT_CONCURRENCY=2

# ---------- AI（可选） ----------
# 留空即进入"无 AI 模式"：文案由服务端规则生成，全部内容可手动编辑，导出不受影响。
AI_API_KEY=
# 任意 OpenAI 兼容接口，例如 https://api.openai.com/v1 、https://api.deepseek.com/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
